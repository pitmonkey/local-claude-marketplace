# Claude Marketplace environment variables
# Copy to .env for local development (not used in Docker — set env vars there)

DATA_DIR=./data
CONFIG_DIR=./config
PORT=8080
STORAGE_BACKEND=sqlite

# S3 backend settings (set STORAGE_BACKEND=s3 to use):
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=marketplace
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
