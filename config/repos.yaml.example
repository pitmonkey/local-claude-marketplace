# Claude Marketplace source repositories
# Copy this file to config/repos.yaml and edit as needed.
#
# ownership: "remote" (default) — third-party repo, deep-walk for all .md files
#            "mine"             — your own repo, use explicit format
# format:    "auto" (default)  — auto-detect layout
#            "flat"            — raw .md files at root
#            "proper"          — subdirs with skill.yaml + SKILL.md

repos:
  # Community skills and agents (recommended starting point)
  - url: https://github.com/VoltAgent/awesome-claude-code-subagents
    name: awesome-claude-code-subagents
    description: Community-contributed Claude Code skills and agents
    ownership: remote
    format: auto

  # Example: your own flat skills repo
  # - url: https://github.com/yourorg/your-skills
  #   name: my-skills
  #   description: Internal company skills
  #   ownership: mine
  #   format: flat

  # Example: local filesystem repo (only works if mounted into the container)
  # - url: /mnt/local-skills
  #   name: local-internal
  #   description: Local skills on this machine
  #   ownership: mine
  #   format: flat

  # Example: private GitHub/GitLab repo
  # Set GIT_AUTH_TOKEN env var at runtime — do NOT put the token here.
  # - url: https://github.com/yourorg/private-skills
  #   name: private-skills
  #   description: Private internal skills
  #   ownership: mine
  #   format: proper
  #   requires_auth: true
  #   subpath: skills  # optional: scan only this subdirectory (e.g. if skills live under skills/)
